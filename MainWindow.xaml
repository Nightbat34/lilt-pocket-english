<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lilt · Pocket English" Width="400" Height="500" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#263D39" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#344C46"/><Setter Property="Background" Value="#EEEEE8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.60"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.42"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#598F80"/><Setter TargetName="Face" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DADFD7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#263D39"/></Style>
  <Style TargetType="ComboBox"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="7,5"/></Style>
 </Window.Resources>
 <Border Background="#F6F5EF" BorderBrush="#D6DCD3" BorderThickness="1" CornerRadius="15">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/><RowDefinition Height="19"/><RowDefinition Height="45"/></Grid.RowDefinitions>
   <Border x:Name="TitleBar" Background="Transparent" CornerRadius="15,15,0,0" Padding="18,0,8,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="29"/><ColumnDefinition Width="29"/><ColumnDefinition Width="29"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#47745D" Margin="0,0,8,0"/><TextBlock Text="lilt" FontFamily="Georgia" FontSize="20" FontStyle="Italic"/><TextBlock Text="  /  pocket English" FontSize="10" Foreground="#849087" VerticalAlignment="Center"/></StackPanel>
     <Button x:Name="SettingsButton" Grid.Column="1" Content="⚙" Padding="0" Background="Transparent" ToolTip="Settings / 设置" FontSize="16"/>
     <Button x:Name="MinimizeButton" Grid.Column="2" Content="−" Padding="0" Background="Transparent" ToolTip="Hide to tray / 隐藏到托盘" FontSize="18"/>
     <Button x:Name="CloseButton" Grid.Column="3" Content="×" Padding="0" Background="Transparent" ToolTip="Save and exit / 保存并退出" FontSize="18"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="18,4,18,0">
    <Grid x:Name="LearnPage">
     <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="47"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="102"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="A little, often." FontSize="21" FontFamily="Georgia"/><TextBlock x:Name="SessionCaption" FontSize="10" Foreground="#859087" Margin="0,3,0,0"/></StackPanel>
      <Button x:Name="ModeButton" Grid.Column="1" Content="IPA first  ↗" FontSize="10" Padding="7,5" VerticalAlignment="Center" Background="#E7EBE1" ToolTip="先看音标，回想单词；再次点击切回单词模式"/>
     </Grid>
     <Border Grid.Row="1" Background="#FFFEFA" BorderBrush="#E2E5DC" BorderThickness="1" CornerRadius="14">
      <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14,18,12">
       <StackPanel>
        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CategoryText" FontSize="9" FontWeight="SemiBold" Foreground="#61816C" VerticalAlignment="Center"/><Button x:Name="SpeakButton" Grid.Column="1" Content="♫" Background="#F1F3EB" Padding="8,2" FontSize="13" ToolTip="Read word and sentence / 朗读；静音模式下不可用"/></Grid>
        <TextBlock x:Name="WordText" FontSize="29" FontFamily="Georgia" TextWrapping="Wrap" LineHeight="34"/>
        <TextBlock x:Name="IpaText" FontSize="15" Foreground="#697A70" Margin="0,5,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="StressText" FontSize="10" Foreground="#879187" Margin="0,3,0,0" TextWrapping="Wrap"/>
        <Button x:Name="RevealWordButton" Content="Reveal word" HorizontalAlignment="Left" Margin="0,9,0,0" Background="#E4EDE4" Padding="12,6"/>
        <Border x:Name="ExampleBorder" BorderBrush="#93AD95" BorderThickness="2,0,0,0" Padding="12,0,0,0" Margin="0,16,0,0"><TextBlock x:Name="ExampleText" FontSize="17" LineHeight="25" TextWrapping="Wrap"/></Border>
        <TextBlock Text="IN PLAIN ENGLISH" FontSize="8" FontWeight="SemiBold" Foreground="#8B958A" Margin="0,14,0,5"/>
        <TextBlock x:Name="DefinitionText" FontSize="12" Foreground="#53685D" TextWrapping="Wrap" LineHeight="19"/>
        <TextBlock x:Name="CollocationText" FontSize="10" Foreground="#869185" Margin="0,9,0,0" TextWrapping="Wrap"/>
        <Button x:Name="ChineseButton" Content="查看中文释义  ＋" Background="Transparent" Foreground="#8B958A" FontSize="10" Padding="0,8,0,1" HorizontalAlignment="Left" Margin="0,6,0,0"/>
        <Border x:Name="ChineseBox" Background="#F3F3EB" CornerRadius="7" Padding="10,8" Margin="0,8,0,0"><TextBlock x:Name="ChineseText" FontSize="11" TextWrapping="Wrap" Foreground="#657267" LineHeight="18"/></Border>
       </StackPanel>
      </ScrollViewer>
     </Border>
     <Grid Grid.Row="2" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="AgainButton" Content="Again" Background="#EEE5DC" ToolTip="1 · 词义忘了，稍后复习" Padding="5,7"/>
      <Button x:Name="SoundButton" Grid.Column="2" Content="Sound unsure" Background="#E8EBDf" ToolTip="2 · 词义认识，读音不熟" Padding="5,7" FontSize="11"/>
      <Button x:Name="GotItButton" Grid.Column="4" Content="Got it  →" Background="#315A49" Foreground="White" ToolTip="3 · 词义和读音都熟悉" Padding="5,7"/>
     </Grid>
    </Grid>
    <Grid x:Name="LibraryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="37"/><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="Your word shelf." FontSize="21" FontFamily="Georgia" VerticalAlignment="Center"/><Button x:Name="AddButton" Content="＋ Add" HorizontalAlignment="Right" Padding="10,5" Background="#E4EBDD"/></Grid>
     <TextBox x:Name="SearchBox" Grid.Row="1" ToolTip="Search English or Chinese / 搜索单词、例句或中文" VerticalAlignment="Top"/>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock x:Name="LibraryCount" FontSize="10" VerticalAlignment="Center" Foreground="#829080"/><ComboBox x:Name="CategoryFilter" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="All topics"/><ComboBoxItem Content="Work &amp; code"/><ComboBoxItem Content="Cars"/><ComboBoxItem Content="AI &amp; news"/></ComboBox></Grid>
     <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="LibraryItems"/></ScrollViewer>
    </Grid>
    <Grid x:Name="ProgressPage" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Little steps add up." FontSize="21" FontFamily="Georgia" Margin="0,7,0,14"/>
     <Border Background="#E7EDDF" CornerRadius="12" Padding="17"><StackPanel><TextBlock Text="TODAY" FontSize="9" Foreground="#74846C"/><TextBlock x:Name="TodayCount" FontSize="35" FontFamily="Georgia" Margin="0,2,0,0"/><TextBlock Text="cards reviewed. Every one counts." FontSize="11" Foreground="#728169"/></StackPanel></Border>
     <TextBlock x:Name="ProgressSummary" FontSize="12" LineHeight="23" Margin="2,14,0,10" TextWrapping="Wrap"/>
     <TextBlock Text="NEEDS A LITTLE MORE TIME" FontSize="9" Foreground="#899281" Margin="2,5,0,8"/>
     <StackPanel x:Name="WeakItems"/>
     <TextBlock Text="Sound familiarity is your own assessment; quiet practice does not measure listening comprehension." FontSize="10" Foreground="#8C9586" TextWrapping="Wrap" LineHeight="16" Margin="2,12,0,4"/>
    </StackPanel></ScrollViewer></Grid>
    <Grid x:Name="SettingsPage" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Make room for English." FontFamily="Georgia" FontSize="20" Margin="0,7,0,16"/>
     <CheckBox x:Name="QuietCheck" Content="Quiet mode · 静音" Margin="0,0,0,12" FontSize="13"/><TextBlock Text="No sound unless you switch this off and press ♫." FontSize="10" Foreground="#829080" TextWrapping="Wrap" Margin="20,-6,0,14"/>
     <CheckBox x:Name="TopmostCheck" Content="Keep on top · 窗口置顶" Margin="0,0,0,17" FontSize="13"/>
     <TextBlock Text="YOUR MIX" FontSize="9" Foreground="#829080"/><TextBlock Text="Work &amp; code   40%&#10;Cars                  35%&#10;AI &amp; news        25%" FontSize="12" LineHeight="23" Margin="0,7,0,15"/>
     <TextBlock x:Name="VoiceInfo" FontSize="11" Foreground="#829080" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ExportButton" Content="Export backup"/><Button x:Name="ImportButton" Grid.Column="2" Content="Restore backup"/></Grid>
     <Button x:Name="FolderButton" Content="Open local data folder ↗" Margin="0,9,0,0" Background="Transparent" HorizontalAlignment="Left" Padding="0,8"/>
     <TextBlock Text="× saves and exits. − hides to the tray.&#10;Progress is also saved after every answer.&#10;Space: show Chinese · 1 / 2 / 3: rate" FontSize="10" Foreground="#829080" TextWrapping="Wrap" LineHeight="18" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer></Grid>
   </Grid>
   <TextBlock x:Name="StatusText" Grid.Row="2" Text="Quiet mode · saved locally" FontSize="9" Foreground="#8C9789" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>
   <Border Grid.Row="3" BorderBrush="#E1E4DA" BorderThickness="0,1,0,0" Margin="18,0"><UniformGrid Columns="3" Margin="0,6,0,7"><Button x:Name="LearnNav" Content="◦  Learn" Padding="7,6" Background="#E5EBDE"/><Button x:Name="LibraryNav" Content="▤  Library" Padding="7,6" Background="Transparent"/><Button x:Name="ProgressNav" Content="↗  Progress" Padding="7,6" Background="Transparent"/></UniformGrid></Border>
  </Grid>
 </Border>
</Window>
